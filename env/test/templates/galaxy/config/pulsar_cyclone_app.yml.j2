# Pulsar app embedded in the Galaxy job handlers for the cyclone_pulsar runner (see the _cyclone_container environment
# in environments.yaml). Each job gets its own directory here, with hardlinks to its inputs (see
# pulsar_cyclone_file_actions.yml), so the tool container only gets those, not Galaxy's object store. Cyclone nodes and
# the Galaxy servers both mount Corral, and the object store is on the same filesystem as this directory.
staging_directory: /corral4/{{ galaxy_instance_codename }}/pulsar_jobs

# Running jobs, recovered when the handler restarts. Each handler process runs its own embedded Pulsar app, so with more
# than one handler this must not be shared. Test runs one handler (gravity config of galaxy_test_servers in
# infrastructure-playbook).
persistence_directory: {{ galaxy_mutable_data_dir }}/pulsar_cyclone_persisted_data

# Containers only, no Conda
tool_dependency_dir: none
conda_auto_init: false
conda_auto_install: false

managers:
  _default_:
    # DRMAA (sharing the handler's DRMAA session and DRMAA_LIBRARY_PATH with the slurm runner), plus scontrol/sacct to
    # tell Galaxy why a job failed (e.g. memory_limit_reached for OOM kills). Needs pulsar-galaxy-lib >= 0.16.1.
    type: queued_slurm
    # For remote_metadata: set_metadata runs on the node, after the tool, in the Pulsar job directory. Pulsar doesn't
    # pass these down from the top level to the managers.
    galaxy_home: {{ galaxy_server_dir }}
    galaxy_virtual_env: /cvmfs/{{ galaxy_cvmfs_repo }}/venv
    galaxy_datatypes_config_file: {{ galaxy_server_dir }}/config/datatypes_conf.xml.sample
